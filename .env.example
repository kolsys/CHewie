# Copy to .env and fill in real values. .env is git-ignored — never commit
# credentials here.

# Used by `npm run deploy:static` (see scripts/deploy-static.mjs).
# Public URL your static assets will be served from (same as --base-url).
DEPLOY_BASE_URL=https://your-bucket.example/chewie/

# S3-compatible endpoint and region for your storage provider.
DEPLOY_S3_ENDPOINT=https://s3.<region>.amazonaws.com
DEPLOY_S3_REGION=us-east-1
DEPLOY_S3_BUCKET=your-bucket
DEPLOY_S3_ACCESS_KEY_ID=
DEPLOY_S3_SECRET_ACCESS_KEY=
# DEPLOY_S3_FORCE_PATH_STYLE=true
